/**
 * Parts Purchase autocomplete reference.
 * Framework-independent: adapt selectors/events to the live page.
 */

function amDebounce(fn, wait = 250) {
  let timer = null;
  return (...args) => {
    clearTimeout(timer);
    timer = setTimeout(() => fn(...args), wait);
  };
}

function amEscapeHtml(value) {
  return String(value ?? '')
    .replaceAll('&','&amp;')
    .replaceAll('<','&lt;')
    .replaceAll('>','&gt;')
    .replaceAll('"','&quot;')
    .replaceAll("'",'&#039;');
}

async function amJson(url) {
  const res = await fetch(url, {
    credentials: 'same-origin',
    headers: {'Accept':'application/json'}
  });
  if (!res.ok) throw new Error('Search failed: HTTP ' + res.status);
  return res.json();
}

function bindPurchasePartSearch(input, menu, onSelect) {
  let active = -1;
  let requestSeq = 0;

  const search = amDebounce(async () => {
    const q = input.value.trim();
    if (q.length < 2) {
      menu.innerHTML = '';
      menu.hidden = true;
      return;
    }

    const seq = ++requestSeq;

    try {
      const data = await amJson('/erp/api/purchase/parts/search?q=' + encodeURIComponent(q));
      if (seq !== requestSeq) return;

      const items = Array.isArray(data.items) ? data.items : [];
      active = -1;

      if (!items.length) {
        menu.innerHTML = '<div class="search-empty">No matching Part found</div>';
        menu.hidden = false;
        return;
      }

      menu.innerHTML = items.map((p, i) =>
        '<button type="button" class="search-result" data-index="'+i+'">'+
          '<b>'+amEscapeHtml(p.code || '')+'</b> '+
          '<span>'+amEscapeHtml(p.name || '')+'</span>'+
          (p.oem_no ? '<small>OEM: '+amEscapeHtml(p.oem_no)+'</small>' : '')+
        '</button>'
      ).join('');
      menu.hidden = false;

      menu.querySelectorAll('.search-result').forEach((button, i) => {
        button.addEventListener('click', () => {
          onSelect(items[i]);
          menu.hidden = true;
        });
      });
    } catch (e) {
      if (seq !== requestSeq) return;
      menu.innerHTML = '<div class="search-error">Part search unavailable</div>';
      menu.hidden = false;
    }
  }, 250);

  input.addEventListener('input', search);

  input.addEventListener('keydown', e => {
    const rows = [...menu.querySelectorAll('.search-result')];
    if (!rows.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      active = Math.min(rows.length - 1, active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      active = Math.max(0, active - 1);
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      rows[active].click();
      return;
    } else {
      return;
    }

    rows.forEach((r,i)=>r.classList.toggle('active', i === active));
    rows[active]?.scrollIntoView({block:'nearest'});
  });
}

function bindPurchaseJobCardSearch(input, menu, onSelect) {
  let requestSeq = 0;

  const search = amDebounce(async () => {
    const q = input.value.trim();
    if (q.length < 2) {
      menu.innerHTML = '';
      menu.hidden = true;
      return;
    }

    const seq = ++requestSeq;

    try {
      const data = await amJson('/erp/api/purchase/job-card-search?q=' + encodeURIComponent(q));
      if (seq !== requestSeq) return;

      const items = Array.isArray(data.items) ? data.items : [];

      if (!items.length) {
        menu.innerHTML =
          '<div class="search-empty">No matching Job Card / Vehicle found</div>';
        menu.hidden = false;
        return;
      }

      menu.innerHTML = items.map((r, i) =>
        '<button type="button" class="search-result" data-index="'+i+'" '+
          (r.selectable === false ? 'disabled' : '')+'>'+
          '<b>'+amEscapeHtml(r.job_card_no || '')+'</b> '+
          '<span>'+amEscapeHtml(r.vehicle_reg_no || '')+'</span>'+
          '<small>'+amEscapeHtml(r.customer_name || '')+
          ' · '+amEscapeHtml(r.status || '')+
          (r.selectable === false ? ' · CLOSED / NOT SELECTABLE' : '')+
          '</small>'+
        '</button>'
      ).join('');
      menu.hidden = false;

      menu.querySelectorAll('.search-result:not([disabled])').forEach(button => {
        button.addEventListener('click', () => {
          const item = items[Number(button.dataset.index)];
          onSelect(item);
          menu.hidden = true;
        });
      });
    } catch (e) {
      if (seq !== requestSeq) return;
      menu.innerHTML =
        '<div class="search-error">Job Card / Vehicle search unavailable</div>';
      menu.hidden = false;
    }
  }, 250);

  input.addEventListener('input', search);
}
