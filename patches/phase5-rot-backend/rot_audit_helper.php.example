$action = strtolower(trim((string)($request['action'] ?? '')));
$sessionId = trim((string)($request['id'] ?? ''));

// IMPORTANT:
// $authenticatedStaffId must come from the verified bearer token/session.
// $rotRow must come from the server-side ROT lookup.
// Never accept staff/job ownership from request JSON.

am_rot_write_audit($pdo, [
    'rot_session_id' => $sessionId,
    'staff_id' => $authenticatedStaffId,
    'job_card_id' => $rotRow['job_card_id'] ?? null,
    'job_card_no' => $rotRow['job_card_no'] ?? null,
