use Illuminate\Support\Facades\Log;

public function create()
{
    // IMPORTANT:
    // Replace these queries with the application's existing models/schema.
    // Every collection passed to Blade is initialized even when no rows exist.

    $accounts = collect();
    $vendors = collect();
    $paymentModes = collect();
    $defaultAccountId = null;

    try {
        // Example only:
        // $accounts = Account::query()
        //     ->where('is_active', 1)
        //     ->orderBy('name')
        //     ->get(['id','code','name','type']);
        //
